<!-- MVC-LP-09 - Vista preparacion.ejs (HU-LP-05): lotes tomados por FEFO -->
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><title>LOGISTPULSE - Preparacion</title>
<style>body{font-family:Arial,sans-serif;max-width:960px;margin:2rem auto;padding:0 1rem;color:#222}h1{color:#1f3864}table{border-collapse:collapse;width:100%;margin:1rem 0}th,td{border:1px solid #bbb;padding:.4rem .6rem;text-align:left}th{background:#d9e2f3}.error{background:#fde8e8;border-left:4px solid #c0392b;padding:.6rem 1rem}.ok{background:#e7f6ec;border-left:4px solid #2e8b57;padding:.6rem 1rem}fieldset{margin:1rem 0}input,button{padding:.35rem;margin:.15rem}a{color:#2e5597}</style></head><body>
<h1>Preparacion de pedido</h1>
<% if (locals.error) { %><div class="error"><strong><%= error %></strong></div><% } %>
<% if (locals.pedido) { %>
<div class="ok">Pedido #<%= pedido.id %> en estado <strong><%= pedido.estado %></strong>. Inventario descontado por FEFO.</div>
<table><tr><th>SKU</th><th>Lote</th><th>Vence</th><th>Ubicacion</th><th>Cantidad tomada</th></tr>
<% pedido.asignaciones.forEach(function(a){ %><tr><td><%= a.sku %></td><td><%= a.lote %></td><td><%= a.fecha_vencimiento %></td><td><%= a.ubicacion %></td><td><%= a.cantidad %></td></tr><% }) %></table>
<% } %>
<p><a href="/inventario">&larr; Volver al inventario</a></p>
</body></html>
